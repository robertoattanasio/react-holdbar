{
  "name": "react-toploader",
  "version": "0.1.0",
  "description": "A CSS-native top loading bar for React: mount a Hold wherever something is loading, and the bar stays open until the last one is gone.",
  "keywords": [
    "react",
    "toploader",
    "loading-bar",
    "progress",
    "suspense",
    "ssr",
    "css",
    "typescript"
  ],
  "license": "MIT",
  "author": "Roberto Attanasio",
  "homepage": "https://dev.robertoattanasio.com/react-toploader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertoattanasio/react-toploader.git"
  },
  "bugs": {
    "url": "https://github.com/robertoattanasio/react-toploader/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "toploader.css"
  ],
  "workspaces": [
    "."
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./toploader.css": "./toploader.css"
  },
  "scripts": {
    "ts:check": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput",
    "build": "rm -rf dist && tsc",
    "changeset:add": "changeset",
    "changeset:bump": "changeset version",
    "build:release": "npm run ts:check && npm run build && npm pack && changeset publish && git push --follow-tags"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1"
  }
}
